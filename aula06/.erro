.resultado,
.ok,
.alerta,
.erro {
white-space: pre-line;
padding: 1rem;
border-radius: 8px;
border-left: 6px solid var(--cor-texto);
background: var(--cor-suave);
}
.ok { border-color: #2E7D32; background: #E8F5E9; }
.alerta { border-color: #F9A825; background: #FFF8E1; }
.erro { border-color: #C62828; background: #FFEBEE; }